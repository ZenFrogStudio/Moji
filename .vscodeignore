# Exclude development and unnecessary files from the VSIX package
.vscode/
.claude/
.git/
.gitignore
node_modules/
.fallow/
test/
docs/
landing/
emoji-test/
.vscode-test/
*.vsix
.tmp-*/
.tmp-*.zip
nul
curl
desktop.ini
package-lock.json
Modelfile
*.md
!README.md
!CHANGELOG.md

# Exclude large source image files (keep only the final icon)
src/img/Others/
src/img/*.clip
src/img/*.ico
