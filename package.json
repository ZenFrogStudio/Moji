{
  "name": "moji",
  "displayName": "Moji",
  "description": "Read code fast and easy.",
  "version": "1.4.31",
  "publisher": "ZenFrog",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "src/img/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZenFrogStudio/Moji"
  },
  "bugs": {
    "url": "https://github.com/ZenFrogStudio/Moji/issues",
    "email": "info@zenfrogstudio.com"
  },
  "homepage": "https://github.com/ZenFrogStudio/Moji",
  "author": {
    "name": "Zen Frog",
    "email": "info@zenfrogstudio.com",
    "url": "https://github.com/ZenFrogStudio/Moji"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "emoji",
    "code visualization",
    "keyword decoration",
    "cognitive",
    "visual coding",
    "code overlay",
    "syntax highlighting",
    "JavaScript",
    "TypeScript",
    "Python",
    "C++",
    "C#",
    "Java",
    "SQL",
    "HTML",
    "CSS"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:python",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:sql",
    "onLanguage:mysql",
    "onLanguage:postgres",
    "onLanguage:plpgsql",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:java"
  ],
  "scripts": {
    "test": "node test/run-tests.js",
    "package": "npm test && vsce package --no-dependencies",
    "publish": "vsce publish"
  },
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mojiPro.toggle",
        "title": "Moji: Toggle"
      },
      {
        "command": "mojiPro.openSettings",
        "title": "Moji: Customize Settings"
      },
      {
        "command": "mojiPro.toggleCodeBlocks",
        "title": "Moji: Toggle Code Block Highlighting"
      },
      {
        "command": "mojiPro.toggleReactComponentOutlines",
        "title": "Moji: Toggle React Component Outlines"
      }
    ],
    "menus": {
      "extension/context": [
        {
          "command": "mojiPro.openSettings",
          "group": "navigation"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1"
  }
}
