{
  "name": "Emoji-Code",
  "displayName": "Emoji-Code",
  "description": "Adds emojis to your coding experience for enhanced memorability and comprehension.",
  "version": "0.3.0",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucidiancreative"
  },
  "icon": "src/img/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "emojiCode.toggle",
        "title": "Emoji-Code: Toggle"
      },
      {
        "command": "emojiCode.openSettings",
        "title": "Customize"
      }
    ],
    "menus": {
      "extension/context": [
        {
          "command": "emojiCode.openSettings",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Emoji-Code",
      "properties": {
        "emojiCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable emoji keyword decorations."
        },
        "emojiCode.displayMode": {
          "type": "string",
          "enum": [
            "replace",
            "overlay"
          ],
          "enumDescriptions": [
            "Hide keyword text and show only the emoji.",
            "Dim keyword text and show the emoji before it."
          ],
          "default": "overlay",
          "description": "How emojis are rendered relative to keywords."
        },
        "emojiCode.overlayOpacity": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "Opacity of keyword text in overlay mode (0 = invisible, 1 = fully visible)."
        },
        "emojiCode.htmlTags": {
          "type": "boolean",
          "default": true,
          "description": "Master toggle: show emojis for HTML tag names."
        },
        "emojiCode.htmlVoidElements": {
          "type": "boolean",
          "default": true,
          "description": "Master toggle: show emojis for HTML void elements."
        },
        "emojiCode.htmlAttributes": {
          "type": "boolean",
          "default": true,
          "description": "Master toggle: show emojis for HTML attribute names."
        },
        "emojiCode.javascriptKeywords": {
          "type": "boolean",
          "default": true,
          "description": "Master toggle: show emojis for JavaScript keywords."
        },
        "emojiCode.jsKeyword.await": {
          "type": "boolean",
          "default": true,
          "description": "⏳ await – waiting for a promise"
        },
        "emojiCode.jsKeyword.break": {
          "type": "boolean",
          "default": true,
          "description": "🛑 break – exit loop / switch"
        },
        "emojiCode.jsKeyword.case": {
